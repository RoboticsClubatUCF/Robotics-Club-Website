# Copy to .env and fill in real values.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=rccf
POSTGRES_PASSWORD=
POSTGRES_DB=rccf
POSTGRES_PORT=5433

# --- Prisma (read by prisma.config.ts) ---
# Must match the values above. Host is localhost from your machine,
# or `postgres` from another container on the same compose network.
DATABASE_URL="postgresql://rccf:PASSWORD@localhost:5433/rccf?schema=public"

# --- API server ---
PORT=4000
# Comma-separated. 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Only set true behind a proxy that overwrites X-Forwarded-For. Left true here
# and an attacker just spoofs the header to dodge the rate limit.
TRUST_PROXY=false

# --- Scaling knobs ---
# instances x DATABASE_POOL_MAX must stay under Postgres max_connections (100).
DATABASE_POOL_MAX=10
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Public GET caching. CACHE_S_MAXAGE is what a CDN obeys.
CACHE_MAX_AGE=60
CACHE_S_MAXAGE=300

# --- Contact form email (Postmark) ---
# All three together, or leave all three out. Two of the three and the server
# refuses to start, on purpose: a half-configured mailer accepts messages, tells
# everyone they were sent, and delivers nothing.
#
# Unset is a supported state. Messages are still written to contact_messages and
# read in Prisma Studio; only the notification is missing, and the API says so
# at startup.
#
# POSTMARK_TOKEN is the *Server* API token, not the account token.
# CONTACT_FROM_EMAIL must be a verified Sender Signature on that account —
# Postmark rejects anything else — and is not where replies go: those go to
# whoever wrote in.
#POSTMARK_TOKEN=
#CONTACT_FROM_EMAIL=website@rccf.example.org
#CONTACT_TO_EMAIL=officers@rccf.example.org
# Transactional mail belongs on the outbound stream, not a broadcast one.
POSTMARK_MESSAGE_STREAM=outbound
