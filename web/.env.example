# Where the content API lives. The frontend calls it cross-origin — this origin
# must appear in the server's CORS_ORIGINS or the browser blocks the request.
# Only VITE_-prefixed vars reach browser code, and they are baked into the
# bundle at build time, so nothing secret goes in this file.
#
# Optional in development: src/lib/api.ts falls back to this exact value.
VITE_API_URL=http://localhost:4000
