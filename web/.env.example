# Where the content API lives. The frontend calls it cross-origin — this site's
# own origin has to be the server's SITE_URL, or reach it through that server's
# CORS_ORIGINS, before the browser will allow the request.
#
# Only VITE_-prefixed vars reach browser code, and they are baked into the
# bundle at build time, so nothing secret goes in this file.
#
# Once the site is served over https this must be https too. A secure page is
# not allowed to call an insecure one: the browser blocks it as mixed content
# before the request is sent, which looks exactly like the API being down.
#
# Optional in development: src/lib/api.ts falls back to this exact value.
VITE_API_URL=http://localhost:4000

# Stripe's publishable key, for the dues page. `pk_test_...` while testing,
# `pk_live_...` once the club is taking real money — and it must be from the
# same Stripe account as the server's STRIPE_SECRET_KEY, or every payment fails
# with a mismatched-intent error that mentions neither key.
#
# Not a secret: it is designed to be read by anyone looking at the page, and it
# can only create payments, never see or move money. The secret key never leaves
# the server.
#
# Unset, the dues page says card payments are not switched on and points at an
# officer, rather than rendering a form that cannot submit. The server has its
# own half of that switch, so check both if the page says the wrong thing.
#VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
