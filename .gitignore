# Dependencies — every package, at any depth.
node_modules

# Build output
dist
dist-ssr
*.local
.vite

# Hand-rolled deploy tarballs of web/dist. The directory is ignored above, so
# the archive of it should be too — otherwise a `git add -A` commits a stale
# 750 KB binary that history can never drop.
*.tar.gz

# Secrets. Only the .env.example files are ever committed.
# The pre-rewrite history of this repo tracked a real .env for three years;
# don't let that happen again.
.env
.env.*
!.env.example

# The Prisma client is generated TypeScript, not source. Run
# `npm run generate` in server/ after pulling a schema change.
server/src/generated

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
